# Copy to .env (never commit .env). All variables are optional.

# Path to the trained model artifact (defaults to models/win_probability_model.joblib).
# IPL_MODEL_PATH=models/win_probability_model.joblib

# Only for automated UI tests: lets the app load a model trained on SYNTHETIC data.
# Never enable this for real use.
# IPL_ALLOW_SYNTHETIC_MODEL=0

# Not required: the Cricsheet dataset needs no credentials. Only set these if you
# choose to use a Kaggle dataset via the Kaggle CLI instead.
# KAGGLE_USERNAME=
# KAGGLE_KEY=
